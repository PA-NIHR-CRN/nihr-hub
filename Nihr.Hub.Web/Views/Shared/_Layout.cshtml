@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Options
@using Nihr.Hub.Infrastructure.Settings
@inject IOptions<AupSettings> AupOptions
@inject IOptions<GoogleAnalyticsSettings> GoogleAnalyticsSettings

<!DOCTYPE html>
<html lang="en" class="nihr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NIHR Hub</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inclusive+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/gds-transport-reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/govuk/govuk-frontend-6.1.0.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nihr.govuk.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/one-login-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NIHR.Hub.Web.styles.css" asp-append-version="true" />

    @{
        var consentCookie = Context.Request.Cookies["CookieConsent"];
        var analyticsConsent = consentCookie == "true";
        var hasRespondedToBanner = !string.IsNullOrEmpty(consentCookie);
    }

    <!-- Google tag (gtag.js) -->
    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('consent', 'default', {
            'ad_storage': '@(hasRespondedToBanner && analyticsConsent ? "granted" : "denied")',
            'analytics_storage': '@(hasRespondedToBanner && analyticsConsent ? "granted" : "denied")',
            'ad_user_data': '@(hasRespondedToBanner && analyticsConsent ? "granted" : "denied")',
            'ad_personalization': '@(hasRespondedToBanner && analyticsConsent ? "granted" : "denied")'
        });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=@GoogleAnalyticsSettings.Value.TagId"></script>
    <script>
        gtag('js', new Date());
        gtag('config', '@GoogleAnalyticsSettings.Value.TagId', {
            'cookie_domain': location.hostname
        });
    </script>
</head>
<body class="govuk-template__body app-body-class">
    <script>
        document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>
    @await Html.PartialAsync("Partials/_CookieBanner")
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

    @await Html.PartialAsync("_Header")
    <div class="govuk-width-container">
        <main id="main-content" class="govuk-main-wrapper" role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="govuk-footer">
        <div class="govuk-width-container">
            <div class="govuk-footer__meta">
                <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
                    <h2 class="govuk-visually-hidden">Support links</h2>
                    <ul class="govuk-footer__inline-list">
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-footer__link" href="https://www.nihr.ac.uk/about-us/who-we-are">
                                About Us
                            </a>
                        </li>
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-footer__link" href="https://www.nihr.ac.uk/contact-us">
                                Contact Us
                            </a>
                        </li>
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-footer__link"
                               href="@AupOptions.Value.Url">
                                Terms &amp; Acceptable Use
                            </a>
                        </li>
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-footer__link"
                               href="https://sites.google.com/nihr.ac.uk/nihr-hub-accessibility/">
                                Accessibility
                            </a>
                        </li>
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-footer__link"
                               href="/cookies">
                                Cookies
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="govuk-footer__meta-item">
                    <a class="govuk-footer__link funded-by-dhsc-logo govuk-!-padding-top-0"
                       href="https://www.gov.uk/government/organisations/department-of-health-and-social-care">
                        <img alt="Funded by the Department of Health and Social Care" src="/images/funded-by-dhsc-white.png" />
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script type="module">
        import {initAll} from '/lib/govuk/govuk-frontend.min.js'

        initAll()
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>