@model AupModel

@{
    ViewData["Title"] = "Home Page";
}

@if (User.Identity is { IsAuthenticated: true })
{
    <h1 class="govuk-heading-l">NIHR Acceptable Use Policy</h1>
    <div class="govuk-grid-row govuk-!-margin-bottom-6">
        <div class="govuk-grid-column-full">
            <iframe class="aup-frame card"
                    src="@Model.Url"
                    width="100%"
                    style="background-color:white;"
                    sandbox="allow-scripts allow-same-origin"
                    referrerpolicy="no-referrer">
            </iframe>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full govuk-!-text-align-right">
            <form asp-action="AcceptAup" method="post">
                <button type="submit" class="govuk-button govuk-button--start">
                    Accept
                    <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
                    </svg>
                    </button>
            </form>
        </div>
    </div>


}