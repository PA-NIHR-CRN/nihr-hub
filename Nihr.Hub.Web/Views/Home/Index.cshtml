@model HomeModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-container">
    <h1 class="govuk-heading-l govuk-!-text-align-centre">Welcome to the NIHR Hub, <b>@Model.GivenName</b></h1>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="govuk-grid-row nihr-justify-content-centre">

                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-form-group govuk-!-margin-bottom-0">
                        <h1 class="govuk-label-wrapper">
                            <label class="govuk-label govuk-visually-hidden" for="nihr-search-input">
                                Search information across the NIHR
                            </label>
                        </h1>
                        <div class="search-wrapper">
                            <form target="_blank" action="https://cloudsearch.google.com/cloudsearch">
                                <input placeholder="Search NIHR" class="govuk-input govuk-!-margin-bottom-0 nihr-input__search"
                                       id="nihr-search-input"
                                       name="q" type="text">
                                <button type="submit" value="Update results" class="search-button">
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full nihr-justify-content-centre">
                    <a class="govuk-link nihr-link-lg nihr-link-arrow-left" href="https://www.nihr.ac.uk/news-views-stories">News, views and stories</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="govuk-grid-row govuk-!-margin-bottom-4">
    <div class="govuk-grid-column-full">
        <h2 class="govuk-heading-m">
            Favourite applications
        </h2>
        <p id="favourites-caption" class="govuk-body">
            Drag application icons into this section to favourite them
        </p>
        <div class="card">
            <div id="favourites-list" class="icon-container content">
                @foreach (var application in Model.Favourites)
                {
                    <a data-id="@application.Id" href="@application.Url" class="icon govuk-link" target="_blank">
                        <img alt="@application.Name"
                             src="images/app-icons/@application.ImageName" />
                        <span class="icon-label">@application.Name</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h2 class="govuk-heading-m">
            All applications
        </h2>
        <p class="govuk-body">For more information on the applications provided as part of the Hub and any specific usage constraints, please visit our <a asp-action="Help" class="govuk-link">applications overview</a> page.</p>
        <div class="card">
            <div id="all-applications" class="icon-container content">
                @foreach (var application in Model.AllApplications)
                {
                    <a data-id="@application.Id" href="@application.Url" class="icon govuk-link" target="_blank">
                        <img alt="@application.Name" src="images/app-icons/@application.ImageName" />
                        <span class="icon-label">@application.Name</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="lib/sortablejs/Sortable.min.js"></script>
    <script src="js/favourite-apps.js"></script>
}
