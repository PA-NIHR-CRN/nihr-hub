@model Nihr.Hub.Web.Models.PoliciesContent
@using Nihr.Hub.Web.Helpers

@{
  ViewData["Title"] = "Policies";
}

@Html.GovUkBreadcrumbs(
  [
    new BreadcrumbItem { Text = "Home", Url = Url.Action("Index", "Home")! },
    new BreadcrumbItem { Text = "Policies", Url = Url.Action("Index", "Policies")! }
  ]
)

<div class="govuk-grid-row govuk-!-margin-top-4">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-l">Policies</h1>
    <p class="govuk-body">
      The following policies apply to all NIHR staff using our centrally-provided IT systems and services.
      Please review these documents and ensure you understand your responsibilities.
    </p>

    <h2 class="govuk-heading-m">Looking for other NIHR policies?</h2>
    <p class="govuk-body">
      This page only covers NIHR's IT policies. If you are an NIHRCC or RDN colleague, you can find all our other
      policies in the
      <a class="govuk-link" href="https://intranet.nihr.ac.uk/site/cce3a0c2-2e86-483b-827b-6e711f4ed00e/page/f087b902-7567-480b-85b8-ea2c7ca94d78" target="_blank" rel="noopener noreferrer">NIHR Library on The Bridge</a>.
      Any public facing policies are also published on the
      <a class="govuk-link" href="https://www.nihr.ac.uk/about-us/who-we-are/policies-and-guidelines" target="_blank" rel="noopener noreferrer">NIHR website</a>.
    </p>
    <p class="govuk-body">
      Please contact <a class="govuk-link" href="mailto:support@nihr.ac.uk">support@nihr.ac.uk</a> if you need
      further support with this page, or if you have other questions about NIHR&rsquo;s IT policies. If you need
      support with a non-IT NIHR policy, please email
      <a class="govuk-link" href="mailto:nihrcc.documentation@nihr.ac.uk">nihrcc.documentation@nihr.ac.uk</a>.
    </p>

    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

    @foreach (var policy in Model.Policies)
    {
      <div class="govuk-!-margin-bottom-6">
        <h2 class="govuk-heading-m">
          <a class="govuk-link" href="@policy.Url" target="_blank" rel="noopener noreferrer">
            @policy.Title
          </a>
        </h2>
        <p class="govuk-body">@policy.Description</p>
      </div>
      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    }
  </div>
</div>
